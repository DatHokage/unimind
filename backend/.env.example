# Database. Mặc định SQLite — chạy local được ngay, không cần cài gì thêm.
# Khi deploy (Render + Supabase): dùng connection string của SESSION POOLER
# (Settings → Database → Connection Pooling), KHÔNG dùng direct connection
# `db.<project-ref>.supabase.co` — host đó ở nhiều region chỉ có IPv6,
# Render free tier không route được → lỗi "Network is unreachable".
# SUPABASE_DB_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_URL=sqlite:///./ql_daotao.db

# JWT
SECRET_KEY=doi-khoa-nay-thanh-chuoi-ngau-nhien-dai
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ====== CHATBOT QUY CHẾ (RAG) — 2 VAI TRÒ ĐỘC LẬP ======
# ① EMBEDDING — chỉ Voyage AI (bắt buộc, key: https://dash.voyageai.com/api-keys).
#    Voyage CHỈ tạo vector cho tìm kiếm, không sinh câu trả lời.
VOYAGE_API_KEY=
# Model embedding cố định (không đổi giữa build index và query). Đổi model
# này là PHẢI rebuild vector store: python scripts/rebuild_vector_store.py
VOYAGE_MODEL=voyage-4

# ② LLM SINH CÂU TRẢ LỜI — OpenRouter (chính, key: https://openrouter.ai/keys)
# + Google Gemini (dự phòng khi OpenRouter lỗi/rate-limit).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Key Gemini — LLM dự phòng cho chatbot quy chế + LLM JSON cho tư vấn học phần
# / tóm tắt học tập. Đặt GOOGLE_API_KEY (khuyến nghị) hoặc GEMINI_API_KEY.
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Nghiệp vụ
PASS_THRESHOLD=5.0

# CORS — danh sách origin được phép gọi API, phân tách bằng dấu phẩy.
# Dev: localhost. Khi deploy frontend lên Vercel, thêm domain vào, VD:
# CORS_ORIGINS=http://localhost:5173,https://unimind.vercel.app
CORS_ORIGINS=http://localhost:5173

# Chatbot quy chế (RAG): cần VOYAGE_API_KEY (embedding — bắt buộc) + ít nhất
# 1 key LLM (OPENROUTER_API_KEY là chính, GOOGLE_API_KEY/GEMINI_API_KEY là dự
# phòng). Vector store trong repo ĐÃ được nhúng bằng voyage-4 (741 chunks) —
# deploy xong là chatbot chạy ngay, không cần rebuild.
# Muốn cập nhật quy chế: đặt file DOCX mới vào backend/data/raw/ rồi chạy
# python scripts/rebuild_vector_store.py và commit lại thư mục vectorstore/.
# Đổi VOYAGE_MODEL cũng bắt buộc rebuild (mỗi model một không gian vector).
