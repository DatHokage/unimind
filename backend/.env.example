# Connection string tới Supabase Postgres (dùng cổng 5432 direct, KHÔNG dùng pooler 6543)
SUPABASE_DB_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@db.<project-ref>.supabase.co:5432/postgres?sslmode=require

# JWT
SECRET_KEY=doi-khoa-nay-thanh-chuoi-ngau-nhien-dai
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# LLM — ưu tiên OpenRouter (miễn phí, nhiều model); không có thì tự fallback Gemini.
# OpenRouter key: https://openrouter.ai/keys — model miễn phí có đuôi :free
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Gemini key (tùy chọn — dự phòng khi OpenRouter lỗi/hết quota):
# https://aistudio.google.com/apikey
# Đặt GOOGLE_API_KEY (khuyến nghị — tên chuẩn SDK Google, pipeline RAG đọc tên này);
# GEMINI_API_KEY (tên cũ) vẫn được chấp nhận. Chỉ cần đặt 1 trong 2.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Nghiệp vụ
PASS_THRESHOLD=5.0

# CORS — danh sách origin được phép gọi API, phân tách bằng dấu phẩy.
# Dev: localhost. Khi deploy frontend lên Vercel, thêm domain vào, VD:
# CORS_ORIGINS=http://localhost:5173,https://unimind.vercel.app
CORS_ORIGINS=http://localhost:5173

# Chatbot quy chế (RAG): đặt OPENROUTER_API_KEY hoặc GEMINI_API_KEY là chạy được —
# vector store dựng sẵn trong backend/vectorstore/. Muốn cập nhật quy chế:
# đặt file DOCX mới vào backend/data/raw/ rồi chạy: python -m src.ingestion.build_index
