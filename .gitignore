# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Môi trường ảo & biến môi trường (KHÔNG push secret)
.venv/
venv/
.env
.env.*
!.env.example

# ===== Cơ sở dữ liệu =====
*.db
*.sqlite
*.sqlite3
# WAL/SHM journal của SQLite
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
# Ngoại lệ: file lõi của vector store RAG (ChromaDB) PHẢI nằm trong repo —
# thiếu chroma.sqlite3 thì chatbot quy chế không chạy được sau khi deploy.
!backend/vectorstore/**/*.sqlite3
!backend/vectorstore/**/*.bin

# ===== Node / Frontend =====
node_modules/
dist/
dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== Log & cache =====
logs/
*.log

# ===== Dữ liệu RAG =====
# RAG chatbot quy che: vectorstore/ được giữ trong repo (11MB, dựng sẵn) để
# chạy được ngay. Chỉ bỏ qua tài liệu gốc, index phụ, cache nhúng và log chat.
backend/data/raw/*.docx
backend/data/raw/*.pdf
backend/data/processed/
backend/logs/
# Cache vector tạm của scripts/rebuild_vector_store.py (resume sau lỗi 429) —
# KHÔNG commit: ~20MB, chỉ có ý nghĩa trên máy đang build dở
backend/vectorstore/.embed_cache_v1.json

# ===== IDE / Editor / OS =====
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ===== File rác do redirect nhầm trên Windows =====
nul
.claude/
